# Every outside source this recipe uses, pinned. Sourced by the build and bench scripts.
# Checked 2026-11-03.

# The LSA code: the SGLang plugin, its kernels and the eval harness (Apache-2.0).
# Initial release, the only commit at the time of pinning.
LSA_REPO=https://github.com/Prefrontal-AI/latent-sparse-attention.git
LSA_COMMIT=906be195c1052aaa74f95852ad1917ce1926ba64

# The authors' SGLang fork that the plugin runs in. Tag lsa-v0.1.0 is a lightweight tag on this commit.
SGLANG_REPO=https://github.com/Prefrontal-AI/sglang.git
SGLANG_TAG=lsa-v0.1.0
SGLANG_COMMIT=042d955ba31b962911f63b114c2fb245effa86f2

# The model, BF16, 55.6 GB (Apache-2.0, not gated).
# The canonical id ends in "27B"; the LSA README writes "27b", which the hub redirects.
# This revision is the one the LSA model card pins, and was also main on 2026-11-03.
MODEL=Qwen/Qwen3.8-27B
MODEL_REVISION=1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0

# The distilled D-LSA map for this model: 6,302,911 bytes, loaded by the server with weights_only=True.
# The sha256 matches the release's SHA256SUMS and a fresh download.
MAP_RELEASE=d-lsa-weights-v1
MAP_FILE=qwen38_27b__long-16k-1M-heavy-key-and-query-d2048.pt
MAP_URL=https://github.com/Prefrontal-AI/latent-sparse-attention/releases/download/d-lsa-weights-v1/qwen38_27b__long-16k-1M-heavy-key-and-query-d2048.pt
MAP_SHA256=24cee934f969756db228a8df7f2bc7613979b63ac3b1d5ac3d9aa42e4339bb9b

# The rotation the map was distilled under: YaRN, factor 40 on the native 262,144, so 10,485,760 positions.
# Copied from src/lsa/assets/models/qwen38_27b.yaml at LSA_COMMIT. Both runs need it, LSA and baseline alike,
# or the comparison measures the rotation too. It replaces the checkpoint's own block whole, and travels as
# {"text_config": {"rope_parameters": ...}} in --json-model-override-args, beside the "lsa" block.
ROPE_PARAMETERS='{"mrope_interleaved":true,"mrope_section":[11,11,10],"rope_type":"yarn","rope_theta":10000000,"partial_rotary_factor":0.25,"factor":40.0,"original_max_position_embeddings":262144}'

# The Python the plugin requires (its pyproject says >=3.12,<3.13), to the patch release.
PYTHON_VERSION=3.12.15

# The fork pins some dependencies and leaves others open, so a later build could get newer ones.
# The resolver ignores anything uploaded after this moment: the day after the fork commit.
EXCLUDE_NEWER=2026-11-01T00:00:00Z
